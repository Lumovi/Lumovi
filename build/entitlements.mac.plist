<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!-- Required by Electron's V8 JIT under the hardened runtime. Credential plugins (aws,
         gke-gcloud-auth-plugin, kubelogin…) are programs of their own, so need nothing here. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
