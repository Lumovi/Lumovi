{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "ES2024.String", "ES2025.Intl"],
    "types": ["node", "electron-vite/node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@backend/*": ["./src/backend/*"]
    }
  },
  "include": [
    "src/main/**/*",
    "src/backend/**/*",
    "src/server/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "electron.vite.config.ts",
    "scripts/vite-*.ts",
    "vite.server.config.ts",
    "vite.mcp-stdio.config.ts"
  ]
}
