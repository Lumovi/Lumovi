{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mode": {
      "enum": ["dashboard", "member", "agent"]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "clusterName": {
      "type": "string",
      "pattern": "^[^/\\s]+$"
    },
    "fleet": {
      "type": "object",
      "properties": {
        "kubeconfigSecret": {
          "type": "string"
        },
        "secrets": {
          "type": "array",
          "items": {
            "enum": ["lumovi", "cluster-api", "argocd"]
          },
          "uniqueItems": true
        },
        "secretNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "agentsSecret": {
          "type": "string"
        },
        "includeThisCluster": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "hubUrl": {
          "type": "string",
          "pattern": "^(https?://\\S+)?$"
        },
        "tokenSecret": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "url": {
      "type": "string",
      "pattern": "^(https?://\\S+)?$"
    },
    "basePath": {
      "type": "string",
      "pattern": "^/?([\\w.~-]+/?)*$"
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["token", "oidc", "proxy"]
        },
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^(https?://\\S+)?$"
            },
            "clientId": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "scopes": {
              "type": "string",
              "minLength": 1
            },
            "usernameClaim": {
              "type": "string",
              "minLength": 1
            },
            "groupsClaim": {
              "type": "string",
              "minLength": 1
            },
            "providerName": {
              "type": "string"
            },
            "forwardToken": {
              "enum": ["", "id", "access"]
            }
          }
        },
        "proxy": {
          "type": "object",
          "properties": {
            "userHeader": {
              "type": "string",
              "minLength": 1
            },
            "groupsHeader": {
              "type": "string",
              "minLength": 1
            },
            "signOutUrl": {
              "type": "string",
              "pattern": "^(https?://\\S+)?$"
            }
          }
        },
        "usernamePrefix": {
          "type": "string"
        },
        "groupsPrefix": {
          "type": "string"
        },
        "sessionHours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 168
        }
      }
    },
    "readOnly": {
      "type": "boolean"
    },
    "assistants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "clusters": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "namespaces": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "visibility": {
                "enum": ["visible", "hidden"]
              },
              "changes": {
                "enum": ["allow", "ask", "never"]
              },
              "secrets": {
                "enum": ["values", "keys", "hidden"]
              },
              "env": {
                "enum": ["show", "sensitive", "all"]
              },
              "logs": {
                "enum": ["read", "off"]
              }
            }
          }
        },
        "changes": {
          "enum": ["", "ask", "allow", "never"]
        },
        "clusters": {
          "type": "object",
          "additionalProperties": {
            "enum": ["ask", "allow", "never"]
          }
        },
        "redirectHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$"
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^(auto|off|[^/:]+/[^/:]+:[^/]+(/.*)?)$"
        }
      }
    },
    "nodeShell": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "image": {
          "type": "string",
          "pattern": "^\\S+$",
          "maxLength": 255
        }
      },
      "additionalProperties": false
    },
    "helm": {
      "type": "object",
      "properties": {
        "allowPrivateCharts": {
          "type": "boolean"
        },
        "artifactHubUrl": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        }
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "from": {
          "type": "array"
        }
      }
    },
    "extraEnv": {
      "type": "array"
    }
  }
}
