{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mode": {
      "enum": ["dashboard", "member", "agent"]
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": ["Always", "IfNotPresent", "Never"]
        }
      }
    },
    "clusterName": {
      "type": "string",
      "pattern": "^[^/\\s]+$"
    },
    "clusterLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "fleet": {
      "type": "object",
      "properties": {
        "kubeconfigSecret": {
          "type": "string"
        },
        "secrets": {
          "type": "array",
          "items": {
            "enum": ["lumovi", "cluster-api", "argocd"]
          },
          "uniqueItems": true
        },
        "secretNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "agentsSecret": {
          "type": "string"
        },
        "includeThisCluster": {
          "type": "boolean"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "hubUrl": {
          "type": "string",
          "pattern": "^(https?://\\S+)?$"
        },
        "tokenSecret": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "url": {
      "type": "string",
      "pattern": "^(https?://\\S+)?$"
    },
    "basePath": {
      "type": "string",
      "pattern": "^/?([\\w.~-]+/?)*$"
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": ["token", "oidc", "proxy"]
        },
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^(https?://\\S+)?$"
            },
            "clientId": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "scopes": {
              "type": "string",
              "minLength": 1
            },
            "usernameClaim": {
              "type": "string",
              "minLength": 1
            },
            "groupsClaim": {
              "type": "string",
              "minLength": 1
            },
            "providerName": {
              "type": "string"
            },
            "forwardToken": {
              "enum": ["", "id", "access"]
            }
          }
        },
        "proxy": {
          "type": "object",
          "properties": {
            "userHeader": {
              "type": "string",
              "minLength": 1
            },
            "groupsHeader": {
              "type": "string",
              "minLength": 1
            },
            "signOutUrl": {
              "type": "string",
              "pattern": "^(https?://\\S+)?$"
            }
          }
        },
        "usernamePrefix": {
          "type": "string"
        },
        "groupsPrefix": {
          "type": "string"
        },
        "sessionHours": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 168
        }
      }
    },
    "readOnly": {
      "type": "boolean"
    },
    "assistants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "clusters": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "namespaces": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                ]
              },
              "visibility": {
                "enum": ["hidden"]
              },
              "changes": {
                "enum": ["ask", "never"]
              },
              "secrets": {
                "enum": ["keys", "hidden"]
              },
              "env": {
                "enum": ["sensitive", "all"]
              },
              "logs": {
                "enum": ["off"]
              }
            }
          }
        },
        "changes": {
          "enum": ["", "ask", "allow", "never"]
        },
        "clusters": {
          "type": "object",
          "additionalProperties": {
            "enum": ["ask", "allow", "never"]
          }
        },
        "redirectHosts": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+$"
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": ["changes", "access"]
        },
        "auditors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stdout": {
          "type": "boolean"
        },
        "persistence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": "string"
            },
            "existingClaim": {
              "type": "string"
            }
          }
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650
        },
        "webhook": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^(https?://.+)?$"
            },
            "format": {
              "enum": ["json", "ndjson"]
            },
            "headersSecret": {
              "type": "string"
            }
          }
        }
      }
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "admins": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "everyone": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "changes": {
                  "enum": ["read", "write"]
                },
                "shells": {
                  "enum": ["off", "on", false, true]
                },
                "nodeShells": {
                  "enum": ["off", "on", false, true]
                },
                "logs": {
                  "enum": ["off", "on", false, true]
                },
                "secrets": {
                  "enum": ["hidden", "keys", "values"]
                },
                "helm": {
                  "enum": ["off", "upgrade", "install", false]
                },
                "assistants": {
                  "enum": ["off", "ask", "self", false]
                },
                "audit": {
                  "enum": ["own", "all"]
                }
              },
              "required": [
                "changes",
                "shells",
                "nodeShells",
                "logs",
                "secrets",
                "helm",
                "assistants",
                "audit"
              ]
            },
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "description": {
                    "type": "string"
                  },
                  "provider": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "people": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "profiles": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name", "values"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "values": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "changes": {
                        "enum": ["read", "write"]
                      },
                      "shells": {
                        "enum": ["off", "on", false, true]
                      },
                      "nodeShells": {
                        "enum": ["off", "on", false, true]
                      },
                      "logs": {
                        "enum": ["off", "on", false, true]
                      },
                      "secrets": {
                        "enum": ["hidden", "keys", "values"]
                      },
                      "helm": {
                        "enum": ["off", "upgrade", "install", false]
                      },
                      "assistants": {
                        "enum": ["off", "ask", "self", false]
                      },
                      "audit": {
                        "enum": ["own", "all"]
                      }
                    },
                    "required": [
                      "changes",
                      "shells",
                      "nodeShells",
                      "logs",
                      "secrets",
                      "helm",
                      "assistants",
                      "audit"
                    ]
                  }
                }
              }
            },
            "grants": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name", "who", "profile"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "who": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "profile": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                  },
                  "clusters": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "namespaces": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            },
            "limits": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "name", "caps"],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "who": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "clusters": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "namespaces": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "caps": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "changes": {
                        "enum": ["read", "write"]
                      },
                      "shells": {
                        "enum": ["off", "on", false, true]
                      },
                      "nodeShells": {
                        "enum": ["off", "on", false, true]
                      },
                      "logs": {
                        "enum": ["off", "on", false, true]
                      },
                      "secrets": {
                        "enum": ["hidden", "keys", "values"]
                      },
                      "helm": {
                        "enum": ["off", "upgrade", "install", false]
                      },
                      "assistants": {
                        "enum": ["off", "ask", "self", false]
                      },
                      "audit": {
                        "enum": ["own", "all"]
                      }
                    }
                  }
                }
              }
            },
            "names": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^(auto|off|[^/:]+/[^/:]+:[^/]+(/.*)?)$"
        }
      }
    },
    "nodeShell": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "maxLength": 63
        },
        "image": {
          "type": "string",
          "pattern": "^\\S+$",
          "maxLength": 255
        }
      },
      "additionalProperties": false
    },
    "helm": {
      "type": "object",
      "properties": {
        "allowPrivateCharts": {
          "type": "boolean"
        },
        "artifactHubUrl": {
          "type": "string",
          "pattern": "^https?://\\S+$"
        }
      }
    },
    "views": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hosts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "from": {
          "type": "array"
        }
      }
    },
    "extraEnv": {
      "type": "array"
    }
  }
}
