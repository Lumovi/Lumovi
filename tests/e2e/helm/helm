#!/usr/bin/env node
// A stand-in for helm in the e2e tests: it records how it was run (in
// $FAKE_HELM_DIR/calls.jsonl) and answers like helm does, or as
// $FAKE_HELM_DIR/responses.json says ({ "<subcommand>": { code, stdout, stderr, signal } }).
import fs from 'node:fs'
import http from 'node:http'
import https from 'node:https'
import path from 'node:path'
import zlib from 'node:zlib'
import { parse, parseAllDocuments } from 'yaml'

const args = process.argv.slice(2)
const dir = process.env.FAKE_HELM_DIR
// `show values`, `dependency list`…: subcommands go by both words.
const command = ['show', 'dependency'].includes(args[0]) ? `${args[0]} ${args[1]}` : args[0]
if (dir) fs.appendFileSync(path.join(dir, 'calls.jsonl'), `${JSON.stringify(args)}\n`)
// The kubeconfig it was given (a Lumovi server writes one for each person's run).
const kubeconfig = process.env.KUBECONFIG
if (dir && kubeconfig && fs.existsSync(kubeconfig)) {
  const record = { args, kubeconfig: fs.readFileSync(kubeconfig, 'utf8') }
  fs.appendFileSync(path.join(dir, 'kubeconfigs.jsonl'), `${JSON.stringify(record)}\n`)
}
// Like helm, it can reach the cluster first ($FAKE_HELM_REACH): its version, as the kubeconfig
// says, recorded with the answer's status (or why there was none).
if (dir && kubeconfig && process.env.FAKE_HELM_REACH) {
  const { clusters, users } = parse(fs.readFileSync(kubeconfig, 'utf8'))
  const { cluster } = clusters[0]
  const { user } = users[0]
  const status = await new Promise((resolve) => {
    https
      .get(
        `${cluster.server}/version`,
        {
          ca: Buffer.from(cluster['certificate-authority-data'], 'base64'),
          servername: cluster['tls-server-name'],
          headers: { Authorization: `Bearer ${user.token}`, 'Impersonate-User': user.as },
        },
        (res) => {
          res.resume()
          resolve(res.statusCode)
        },
      )
      .on('error', (error) => resolve(error.message))
  })
  fs.appendFileSync(path.join(dir, 'reached.jsonl'), `${JSON.stringify({ args, status })}\n`)
}

const responses = (() => {
  try {
    return JSON.parse(fs.readFileSync(path.join(dir, 'responses.json'), 'utf8'))
  } catch {
    return {}
  }
})()
const scripted = responses[command]
if (scripted) {
  process.stdout.write(scripted.stdout ?? '')
  process.stderr.write(scripted.stderr ?? '')
  // Stopped, as helm is when it runs too long.
  if (scripted.signal) process.kill(process.pid, scripted.signal)
  process.exit(scripted.code ?? 0)
}

const option = (name) => {
  const i = args.indexOf(name)
  return i === -1 ? undefined : args[i + 1]
}

// Lumovi's metrics stack ($FAKE_HELM_STACK: what the chart Lumovi ships renders to, with its
// values) is made in the cluster, as helm would, and its release recorded there; uninstalled,
// it's deleted from it. The cluster is the kubeconfig's, by --kube-context.
const stack = process.env.FAKE_HELM_STACK && args[1] === 'lumovi-metrics'
if (stack && (command === 'install' || command === 'uninstall')) {
  const manifest = fs.readFileSync(process.env.FAKE_HELM_STACK, 'utf8')
  const namespace = option('--namespace')
  const dryRun = args.includes('--dry-run=server')
  const record = {
    name: args[1],
    namespace,
    version: 1,
    info: { status: dryRun ? 'pending-install' : 'deployed', notes: '' },
    chart: { metadata: { name: 'prometheus', version: '29.36.1', appVersion: 'v3.15.0' } },
    manifest,
  }
  const objects = [
    ...parseAllDocuments(manifest)
      .map((document) => document.toJS())
      .filter(Boolean)
      // Helm's own mark on what a release makes: whose it is.
      .map((object) => ({
        ...object,
        metadata: {
          ...object.metadata,
          annotations: {
            ...object.metadata.annotations,
            'meta.helm.sh/release-name': args[1],
            'meta.helm.sh/release-namespace': namespace,
          },
        },
      })),
    {
      apiVersion: 'v1',
      kind: 'Secret',
      type: 'helm.sh/release.v1',
      metadata: {
        name: `sh.helm.release.v1.${args[1]}.v1`,
        labels: { name: args[1], owner: 'helm', status: 'deployed', version: '1' },
      },
      data: {
        release: Buffer.from(zlib.gzipSync(JSON.stringify(record)).toString('base64')).toString(
          'base64',
        ),
      },
    },
  ]
  if (!dryRun) {
    for (const object of command === 'install' ? objects : objects.reverse()) {
      const status = await send(command === 'install' ? 'POST' : 'DELETE', object, namespace)
      // Like helm: what's there already isn't taken over, and what the cluster refuses stops it.
      if (status >= 400 && !(command === 'uninstall' && status === 404)) {
        console.error(
          `Error: ${command === 'install' ? 'INSTALLATION FAILED' : 'uninstallation failed'}: ${object.kind} ${object.metadata.name}: the cluster answered ${status}`,
        )
        process.exit(1)
      }
    }
  }
  console.log(command === 'install' ? JSON.stringify(record) : `release "${args[1]}" uninstalled`)
  process.exit(0)
}

switch (command) {
  case 'version':
    console.log('v3.18.4+gd80839c')
    break
  case 'rollback':
    console.log('Rollback was a success! Happy Helming!')
    break
  case 'uninstall':
    console.log(`release "${args[1]}" uninstalled`)
    break
  case 'show values':
    // A chart folder's own values; anything else, some made up.
    process.stdout.write(
      fs.existsSync(path.join(args[2], 'values.yaml'))
        ? fs.readFileSync(path.join(args[2], 'values.yaml'), 'utf8')
        : 'replicaCount: 1\nimage:\n  repository: ghcr.io/example/app\n  tag: "1.0"\n',
    )
    break
  case 'show chart':
    process.stdout.write(chartYaml(args[2]))
    break
  case 'lint': {
    // What a chart's .lint file says (as helm lint would), and an error if the values ask for one.
    const chart = args[1]
    const found = fs.existsSync(path.join(chart, '.lint'))
      ? fs.readFileSync(path.join(chart, '.lint'), 'utf8')
      : '[INFO] Chart.yaml: icon is recommended\n'
    const asked = fs.readFileSync(option('--values'), 'utf8').includes('lint-error')
      ? '[ERROR] templates/: the values ask for an error\n  on a second line\n'
      : ''
    const failed = /\[ERROR\]/.test(found + asked)
    process.stdout.write(
      `==> Linting ${chart}\n${found}${asked}\n1 chart(s) linted, ${failed ? 1 : 0} chart(s) failed\n`,
    )
    if (failed) {
      process.stderr.write('Error: 1 chart(s) linted, 1 chart(s) failed\n')
      process.exit(1)
    }
    break
  }
  case 'dependency list': {
    const chart = args[2]
    const { dependencies = [] } = parse(fs.readFileSync(path.join(chart, 'Chart.yaml'), 'utf8'))
    const rows = dependencies.map((d) => {
      const there = fs.existsSync(path.join(chart, 'charts', `${d.name}-${d.version}.tgz`))
      return [d.name, d.version, d.repository, there ? 'ok' : 'missing'].join('\t')
    })
    console.log(['NAME\tVERSION\tREPOSITORY\tSTATUS', ...rows].join('\n'))
    break
  }
  case 'dependency update': {
    const chart = args[2]
    const { dependencies = [] } = parse(fs.readFileSync(path.join(chart, 'Chart.yaml'), 'utf8'))
    fs.mkdirSync(path.join(chart, 'charts'), { recursive: true })
    for (const d of dependencies) {
      fs.writeFileSync(path.join(chart, 'charts', `${d.name}-${d.version}.tgz`), '')
    }
    console.log(`Saving ${dependencies.length} charts\nDeleting outdated charts`)
    break
  }
  case 'install':
  case 'upgrade': {
    // What it would make: the values it was given, and what's in the chart folder if it's one.
    const name = args[1]
    const chart = args[2]
    const values = fs.readFileSync(option('--values'), 'utf8')
    let made = ''
    if (fs.existsSync(path.join(chart, 'Chart.yaml'))) {
      const folder = path.join(chart, 'templates')
      const templates = fs.existsSync(folder) ? fs.readdirSync(folder).sort() : []
      made = `# Chart folder: ${fs.readFileSync(path.join(chart, 'Chart.yaml'), 'utf8').match(/^version: (.*)$/m)[1]}, templates ${templates.join(', ')}\n`
    }
    const manifest = `---\n# Source: ${path.basename(chart)}/templates/values.yaml\n${made}apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: ${name}-values\ndata:\n  values.yaml: |\n${values
      .split('\n')
      .map((line) => `    ${line}`)
      .join('\n')}\n`
    const dryRun = args.includes('--dry-run=server')
    console.log(
      JSON.stringify({
        name,
        namespace: option('--namespace'),
        version: command === 'install' ? 1 : 4,
        info: {
          status: dryRun ? `pending-${command}` : 'deployed',
          notes: `${name} is ready.\n`,
        },
        manifest,
      }),
    )
    break
  }
  default:
    console.error(`Error: unknown command "${command}" for "helm"`)
    process.exit(1)
}

/** A chart's Chart.yaml: from its folder, or from inside its package. */
function chartYaml(chart) {
  try {
    return fs.readFileSync(path.join(chart, 'Chart.yaml'), 'utf8')
  } catch {
    // Not a folder with one: a package.
  }
  // A package is a gzipped tar, read here rather than by a tar program (Git for Windows'
  // tar takes `C:` in a path for a host): 512-byte headers, each followed by its file.
  const archive = zlib.gunzipSync(fs.readFileSync(chart))
  for (let offset = 0; offset + 512 <= archive.length;) {
    const field = (start, length) =>
      archive.toString('utf8', offset + start, offset + start + length).replace(/\0.*$/s, '')
    const name = [field(345, 155), field(0, 100)].filter(Boolean).join('/')
    if (!name) break
    const size = parseInt(field(124, 12).trim() || '0', 8)
    if (/^[^/]+\/Chart\.yaml$/.test(name)) {
      return archive.toString('utf8', offset + 512, offset + 512 + size)
    }
    offset += 512 + Math.ceil(size / 512) * 512
  }
  throw new Error(`${chart} has no Chart.yaml`)
}

/** Where each kind of the metrics stack's is, in the API. */
function collection(object, namespace) {
  const cluster = { ClusterRole: 'clusterroles', ClusterRoleBinding: 'clusterrolebindings' }
  const plural = `${object.kind.toLowerCase()}s`
  const root = object.apiVersion === 'v1' ? '/api/v1' : `/apis/${object.apiVersion}`
  return cluster[object.kind] ? `${root}/${plural}` : `${root}/namespaces/${namespace}/${plural}`
}

/** Creates or deletes an object in the cluster --kube-context names: the answer's status. */
function send(method, object, namespace) {
  const config = parse(fs.readFileSync(kubeconfig, 'utf8'))
  const context = config.contexts.find((c) => c.name === option('--kube-context')).context
  const { cluster } = config.clusters.find((c) => c.name === context.cluster)
  const { user } = config.users.find((u) => u.name === context.user)
  const where = collection(object, namespace)
  const url = new URL(
    `${cluster.server}${method === 'POST' ? where : `${where}/${object.metadata.name}`}`,
  )
  const body = method === 'POST' ? JSON.stringify(object) : undefined
  return new Promise((resolve, reject) => {
    const request = (url.protocol === 'https:' ? https : http).request(
      url,
      {
        method,
        ...(cluster['certificate-authority-data']
          ? { ca: Buffer.from(cluster['certificate-authority-data'], 'base64') }
          : {}),
        servername: cluster['tls-server-name'],
        headers: {
          ...(user.token ? { Authorization: `Bearer ${user.token}` } : {}),
          ...(user.as ? { 'Impersonate-User': user.as } : {}),
          ...(body ? { 'Content-Type': 'application/json' } : {}),
        },
      },
      (response) => {
        response.resume()
        response.on('end', () => resolve(response.statusCode))
      },
    )
    request.on('error', reject)
    request.end(body)
  })
}
