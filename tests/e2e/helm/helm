#!/usr/bin/env node
// A stand-in for helm in the e2e tests: it records how it was run (in
// $FAKE_HELM_DIR/calls.jsonl) and answers like helm does, or as
// $FAKE_HELM_DIR/responses.json says ({ "<subcommand>": { code, stdout, stderr, signal } }).
import { execFileSync } from 'node:child_process'
import fs from 'node:fs'
import os from 'node:os'
import path from 'node:path'
import { parse } from 'yaml'

const args = process.argv.slice(2)
const dir = process.env.FAKE_HELM_DIR
// `show values`, `dependency list`…: subcommands go by both words.
const command = ['show', 'dependency'].includes(args[0]) ? `${args[0]} ${args[1]}` : args[0]
if (dir) fs.appendFileSync(path.join(dir, 'calls.jsonl'), `${JSON.stringify(args)}\n`)

const responses = (() => {
  try {
    return JSON.parse(fs.readFileSync(path.join(dir, 'responses.json'), 'utf8'))
  } catch {
    return {}
  }
})()
const scripted = responses[command]
if (scripted) {
  process.stdout.write(scripted.stdout ?? '')
  process.stderr.write(scripted.stderr ?? '')
  // Stopped, as helm is when it runs too long.
  if (scripted.signal) process.kill(process.pid, scripted.signal)
  process.exit(scripted.code ?? 0)
}

const option = (name) => {
  const i = args.indexOf(name)
  return i === -1 ? undefined : args[i + 1]
}

switch (command) {
  case 'version':
    console.log('v3.18.4+gd80839c')
    break
  case 'rollback':
    console.log('Rollback was a success! Happy Helming!')
    break
  case 'uninstall':
    console.log(`release "${args[1]}" uninstalled`)
    break
  case 'show values':
    // A chart folder's own values; anything else, some made up.
    process.stdout.write(
      fs.existsSync(path.join(args[2], 'values.yaml'))
        ? fs.readFileSync(path.join(args[2], 'values.yaml'), 'utf8')
        : 'replicaCount: 1\nimage:\n  repository: ghcr.io/example/app\n  tag: "1.0"\n',
    )
    break
  case 'show chart':
    process.stdout.write(fs.readFileSync(chartYaml(args[2]), 'utf8'))
    break
  case 'lint': {
    // What a chart's .lint file says (as helm lint would), and an error if the values ask for one.
    const chart = args[1]
    const found = fs.existsSync(path.join(chart, '.lint'))
      ? fs.readFileSync(path.join(chart, '.lint'), 'utf8')
      : '[INFO] Chart.yaml: icon is recommended\n'
    const asked = fs.readFileSync(option('--values'), 'utf8').includes('lint-error')
      ? '[ERROR] templates/: the values ask for an error\n  on a second line\n'
      : ''
    const failed = /\[ERROR\]/.test(found + asked)
    process.stdout.write(
      `==> Linting ${chart}\n${found}${asked}\n1 chart(s) linted, ${failed ? 1 : 0} chart(s) failed\n`,
    )
    if (failed) {
      process.stderr.write('Error: 1 chart(s) linted, 1 chart(s) failed\n')
      process.exit(1)
    }
    break
  }
  case 'dependency list': {
    const chart = args[2]
    const { dependencies = [] } = parse(fs.readFileSync(path.join(chart, 'Chart.yaml'), 'utf8'))
    const rows = dependencies.map((d) => {
      const there = fs.existsSync(path.join(chart, 'charts', `${d.name}-${d.version}.tgz`))
      return [d.name, d.version, d.repository, there ? 'ok' : 'missing'].join('\t')
    })
    console.log(['NAME\tVERSION\tREPOSITORY\tSTATUS', ...rows].join('\n'))
    break
  }
  case 'dependency update': {
    const chart = args[2]
    const { dependencies = [] } = parse(fs.readFileSync(path.join(chart, 'Chart.yaml'), 'utf8'))
    fs.mkdirSync(path.join(chart, 'charts'), { recursive: true })
    for (const d of dependencies) {
      fs.writeFileSync(path.join(chart, 'charts', `${d.name}-${d.version}.tgz`), '')
    }
    console.log(`Saving ${dependencies.length} charts\nDeleting outdated charts`)
    break
  }
  case 'install':
  case 'upgrade': {
    // What it would make: the values it was given, and what's in the chart folder if it's one.
    const name = args[1]
    const chart = args[2]
    const values = fs.readFileSync(option('--values'), 'utf8')
    let made = ''
    if (fs.existsSync(path.join(chart, 'Chart.yaml'))) {
      const folder = path.join(chart, 'templates')
      const templates = fs.existsSync(folder) ? fs.readdirSync(folder).sort() : []
      made = `# Chart folder: ${fs.readFileSync(path.join(chart, 'Chart.yaml'), 'utf8').match(/^version: (.*)$/m)[1]}, templates ${templates.join(', ')}\n`
    }
    const manifest = `---\n# Source: ${path.basename(chart)}/templates/values.yaml\n${made}apiVersion: v1\nkind: ConfigMap\nmetadata:\n  name: ${name}-values\ndata:\n  values.yaml: |\n${values
      .split('\n')
      .map((line) => `    ${line}`)
      .join('\n')}\n`
    const dryRun = args.includes('--dry-run=server')
    console.log(
      JSON.stringify({
        name,
        namespace: option('--namespace'),
        version: command === 'install' ? 1 : 4,
        info: {
          status: dryRun ? `pending-${command}` : 'deployed',
          notes: `${name} is ready.\n`,
        },
        manifest,
      }),
    )
    break
  }
  default:
    console.error(`Error: unknown command "${command}" for "helm"`)
    process.exit(1)
}

/** A chart's Chart.yaml: in its folder, or inside its package. */
function chartYaml(chart) {
  if (fs.statSync(chart).isDirectory()) return path.join(chart, 'Chart.yaml')
  const unpacked = fs.mkdtempSync(path.join(os.tmpdir(), 'fake-helm-'))
  // Extracted from where it is: Git for Windows' tar reads `C:` in an archive's path as a host.
  execFileSync('tar', ['-xzf', path.basename(chart), '-C', unpacked], { cwd: path.dirname(chart) })
  return path.join(unpacked, fs.readdirSync(unpacked)[0], 'Chart.yaml')
}
