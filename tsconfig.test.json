{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "ES2024.String", "ES2025.Intl", "DOM"],
    "types": ["node"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@backend/*": ["./src/backend/*"]
    }
  },
  "include": [
    "tests/**/*",
    "scripts/**/*",
    "playwright.config.ts",
    "playwright.integration.config.ts",
    "src/shared/**/*",
    "src/preload/api.d.ts"
  ]
}
