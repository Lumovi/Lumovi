{
  "name": "kubestacks",
  "productName": "KubeStacks",
  "version": "1.1.1",
  "description": "A beautiful, fast Kubernetes app for the desktop.",
  "keywords": [
    "kubernetes",
    "k8s",
    "desktop",
    "electron",
    "dashboard",
    "cluster"
  ],
  "homepage": "https://github.com/KubeStacks/KubeStacks#readme",
  "bugs": {
    "url": "https://github.com/KubeStacks/KubeStacks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KubeStacks/KubeStacks.git"
  },
  "license": "Apache-2.0",
  "author": "KubeStacks contributors",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "node scripts/dev-mock.ts",
    "mock-cluster": "node tests/mock-cluster/cli.ts",
    "build": "electron-vite build",
    "build:coverage": "cross-env KUBESTACKS_COVERAGE=true electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:e2e",
    "test:e2e": "npm run build:coverage && playwright test",
    "test:linux": "node scripts/test-linux.ts",
    "coverage": "npm run test:e2e && nyc report",
    "coverage:report": "nyc report",
    "coverage:check": "node scripts/check-coverage.ts",
    "kind:up": "node tests/integration/cluster.ts up",
    "kind:down": "node tests/integration/cluster.ts down",
    "test:integration": "npm run build && playwright test -c playwright.integration.config.ts",
    "test:kind": "npm run kind:up && npm run test:integration",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run coverage"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "croner": "^10.0.1",
    "cronstrue": "^3.27.0",
    "cross-env": "^10.1.0",
    "diff": "^9.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "istanbul-lib-instrument": "^6.0.3",
    "lucide-react": "^1.49.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "selfsigned": "^5.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron-winstaller": true,
    "esbuild": true,
    "fsevents": false
  }
}
