{
  "name": "lumovi",
  "productName": "Lumovi",
  "version": "1.23.1",
  "description": "A calm, fast Kubernetes dashboard, on your desktop or in your cluster.",
  "keywords": [
    "kubernetes",
    "k8s",
    "desktop",
    "electron",
    "dashboard",
    "cluster"
  ],
  "homepage": "https://github.com/Lumovi/Lumovi#readme",
  "bugs": {
    "url": "https://github.com/Lumovi/Lumovi/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lumovi/Lumovi.git"
  },
  "license": "Apache-2.0",
  "author": "Lumovi contributors",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "node scripts/dev-mock.ts",
    "mock-cluster": "node tests/mock-cluster/cli.ts",
    "build": "electron-vite build && vite build -c vite.server.config.ts && vite build -c vite.agent.config.ts && vite build -c vite.mcp-stdio.config.ts && node scripts/sbom.ts",
    "build:coverage": "cross-env LUMOVI_COVERAGE=true npm run build",
    "start": "electron-vite preview",
    "serve": "node out/server/index.js",
    "screenshots": "npm run build && node scripts/screenshots/index.ts",
    "screenshots:stop": "node scripts/screenshots/clusters.ts stop",
    "dev:server": "node scripts/dev-server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:e2e",
    "test:e2e": "npm run build:coverage && playwright test",
    "test:linux": "node scripts/test-linux.ts",
    "coverage": "npm run test:e2e && nyc report",
    "coverage:report": "nyc report",
    "coverage:check": "node scripts/check-coverage.ts",
    "test:durations": "node scripts/e2e-durations.ts",
    "kind:up": "node tests/integration/cluster.ts up",
    "kind:down": "node tests/integration/cluster.ts down",
    "test:integration": "npm run build && playwright test -c playwright.integration.config.ts",
    "plugins:check": "playwright test -c playwright.plugins.config.ts",
    "plugin-kit": "cross-env LUMOVI_PLUGIN_KIT=write playwright test -c playwright.plugins.config.ts declared-one-source",
    "crds": "node scripts/crds.ts",
    "test:kind": "npm run kind:up && npm run test:integration",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run plugins:check && npm run coverage",
    "version": "node scripts/chart-version.ts && node scripts/plugin-since.ts && node scripts/changelog.ts release",
    "changelog": "node scripts/changelog.ts",
    "postinstall": "node scripts/node-pty.ts"
  },
  "dependencies": {
    "@kubernetes/client-node": "^2.0.0",
    "@sigstore/core": "^4.0.1",
    "electron-updater": "^6.8.10",
    "node-pty": "1.1.0",
    "tailwind-merge": "^3.7.0",
    "tar-stream": "3.2.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@electron/fuses": "^2.1.3",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@peculiar/x509": "^2.1.0",
    "@playwright/test": "^1.64.0",
    "@sigstore/tuf": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.19",
    "@types/istanbul-lib-coverage": "^2.0.6",
    "@types/istanbul-lib-instrument": "^1.7.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "croner": "^10.0.1",
    "cronstrue": "^3.32.0",
    "cross-env": "^10.1.0",
    "diff": "^9.0.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.17.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "istanbul-lib-instrument": "^6.0.3",
    "lucide-react": "^1.56.0",
    "nyc": "^18.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "reflect-metadata": "^0.2.2",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron-winstaller": true,
    "esbuild": true,
    "fsevents": false,
    "node-pty": true,
    "sharp": false
  }
}
